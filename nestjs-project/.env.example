# Application
NODE_ENV=development
PORT=3000

# Database (PostgreSQL)
DB_HOST=db
DB_PORT=5432
DB_USERNAME=streamtube
DB_PASSWORD=streamtube
DB_NAME=streamtube

# JWT
JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-refresh-in-production
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
CONFIRMATION_TOKEN_EXPIRATION_HOURS=1
PASSWORD_RESET_TOKEN_EXPIRATION_HOURS=1

# Mail (Mailpit for local development)
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM="StreamTube <noreply@streamtube.com>"

# Object storage (pgsty/silo, S3-compatible). Compose uses the access/secret
# keys as the storage root credentials and the API reads them as the S3 client
# credentials, so they are defined once, here.
S3_ENDPOINT=http://storage:9000
# Address the browser reaches (presigned URLs are signed for this host). The only
# host in this file that is not a Compose service name, because it is used by
# the client outside Docker.
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=streamtube
S3_ACCESS_KEY=streamtube
S3_SECRET_KEY=streamtube-secret
S3_CORS_ALLOWED_ORIGINS=*

# Queue (Redis, BullMQ)
REDIS_HOST=redis
REDIS_PORT=6379
QUEUE_PREFIX=bull
VIDEO_JOB_ATTEMPTS=3
VIDEO_JOB_BACKOFF_MS=30000

# Videos (upload and processing)
UPLOAD_PART_SIZE_BYTES=67108864
UPLOAD_MAX_SIZE_BYTES=10737418240
PART_URLS_MAX_BATCH=100
PRESIGN_PART_EXPIRES_SECONDS=3600
PRESIGN_GET_EXPIRES_SECONDS=900
VIDEOS_THROTTLE_LIMIT=120
VIDEOS_THROTTLE_TTL_MS=60000
MEDIA_TOOL_TIMEOUT_MS=600000
